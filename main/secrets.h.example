#pragma once

// Template for secrets.h - copy it and fill in your own values:
//     cp main/secrets.h.example main/secrets.h
// secrets.h is listed in .gitignore and never committed. The build stops
// with a message if it is missing.

// Up to 3 WiFi networks - tried in order, cycling through the configured
// ones on failure (see wifi_connect.h). Leave the SSID "" for unused slots.
#define WIFI_SSID_1 "your-wifi-ssid"
#define WIFI_PASS_1 "your-wifi-password"
#define WIFI_SSID_2 ""
#define WIFI_PASS_2 ""
#define WIFI_SSID_3 ""
#define WIFI_PASS_3 ""

// Pushover Open Client credentials - NOT your account's user key or an
// application's API token. Get them once, see README, "Pushover device":
//   1. POST email + password to https://api.pushover.net/1/users/login.json
//      -> "secret"
//   2. POST secret + name=pushover-esp32 + os=O to
//      https://api.pushover.net/1/devices.json -> "id"
#define PUSHOVER_SECRET    "your-open-client-secret"
#define PUSHOVER_DEVICE_ID "your-device-id"
